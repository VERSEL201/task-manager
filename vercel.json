{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client && node scripts/vercel-postbuild.js",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/tasks",
      "destination": "/index.html"
    }
  ]
}
